<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">KINO VR</string>
    <style name="AppTheme" parent="BaseAppTheme"/>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:alertDialogTheme">@style/LocalDialogTheme</item>
        <item name="android:colorAccent">#FF7A18</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="ConfirmationTheme" parent="BaseConfirmationTheme"/>
    <style name="BaseConfirmationTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.64</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#FF7A18</item>
    </style>
    <style name="LocalDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF7A18</item>
        <item name="android:colorControlNormal">#8E929A</item>
        <item name="android:colorControlActivated">#FF7A18</item>
        <item name="android:textColorPrimary">#F5F6F8</item>
        <item name="android:textColorSecondary">#8E929A</item>
        <item name="android:colorBackground">#191B1F</item>
        <item name="android:windowBackground">@drawable/dialog_panel</item>
        <item name="android:windowMinWidthMajor">60%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

