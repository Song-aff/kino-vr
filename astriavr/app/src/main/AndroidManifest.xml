<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <!-- 唯一新增权限：访问用户手动填写的局域网 HTTP(S) 片源地址（FR-01 / G1）。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:name=".VrApplication" android:allowBackup="false" android:fullBackupContent="false"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true" android:enableOnBackInvokedCallback="true" android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_compat" android:roundIcon="@mipmap/ic_launcher_compat" android:theme="@style/AppTheme">
        <activity android:name=".CrashActivity" android:exported="false" />
        <!-- 4.9 手柄按键映射：捕获 keyCode 的全屏配置页，不导出。 -->
        <activity android:name=".GamepadMappingActivity" android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation" />
        <!-- H0：首页是 LAUNCHER。播放页保留 exported=true，instrumentation 仍可直接启动。 -->
        <activity android:name=".HomeActivity" android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation" />
    </application>
</manifest>
